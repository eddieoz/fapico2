<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="{{ path_to_root }}css/general.css">
    <link rel="stylesheet" href="{{ path_to_root }}css/chrome.css">
    <link rel="stylesheet" href="{{ path_to_root }}css/print.css" media="print">
    <link rel="stylesheet" href="{{ path_to_root }}css/variables.css">
    {{#if enable_search}}
    <link rel="stylesheet" href="{{ path_to_root }}css/search.css">
    {{/if}}
    <link rel="stylesheet" href="{{ path_to_root }}theme/css/custom.css">
    {{#if copy_fonts}}
    <link rel="stylesheet" href="{{ path_to_root }}fonts/fonts.css">
    {{/if}}
    <link rel="icon" href="{{ path_to_root }}favicon.svg">
    {{#if mathjax_support}}
    <script async src="{{ path_to_root }}mathjax.js"></script>
    {{/if}}
</head>
<body>
    <div id="page" class="page">
        <div id="menu-bar" class="menu-bar">
            <div id="menu-bar-sticky-container" class="menu-bar-sticky-container">
                <div class="left-buttons">
                    <button id="sidebar-toggle" class="icon-button" type="button" title="Toggle Table of Contents" aria-label="Toggle Table of Contents" aria-controls="sidebar">
                        <i class="fa fa-bars"></i>
                    </button>
                    <a href="{{ path_to_root }}index.html">
                        <button id="home-button" class="icon-button" type="button" title="Go to home page" aria-label="Go to home page">
                            <i class="fa fa-home"></i>
                        </button>
                    </a>
                </div>
                <div class="menu-title">
                    {{ book_title }}
                </div>
                <div class="right-buttons">
                    <button id="theme-toggle" class="icon-button" type="button" title="Change theme" aria-label="Change theme">
                        <i class="fa fa-paint-brush"></i>
                    </button>
                    <button id="search-toggle" class="icon-button" type="button" title="Search" aria-label="Search">
                        <i class="fa fa-search"></i>
                    </button>
                    <a href="{{ path_to_root }}print.html" target="_blank" rel="noopener" title="Print this book" aria-label="Print this book">
                        <button id="print-button" class="icon-button" type="button">
                            <i class="fa fa-print"></i>
                        </button>
                    </a>
                </div>
            </div>
        </div>
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-scrollbox">
                <ol class="chapter">
                    {{#toc}}
                    {{/toc}}
                </ol>
            </div>
        </nav>
        <main class="page-wrapper">
            <div class="page" id="page-wrapper">
                {{{ content }}}
            </div>
        </main>
    </div>
    <script src="{{ path_to_root }}js/clipboard.min.js"></script>
    <script src="{{ path_to_root }}js/highlight.js"></script>
    <script src="{{ path_to_root }}js/playground.js"></script>
    <script src="{{ path_to_root }}js/mark.min.js"></script>
    <script src="{{ path_to_root }}js/elasticlunr.min.js"></script>
    <script src="{{ path_to_root }}js/search_index.en.js"></script>
    <script src="{{ path_to_root }}js/searcher.js"></script>
    <script src="{{ path_to_root }}js/sidebar.js"></script>
    <script src="{{ path_to_root }}js/theme.js"></script>
    <script src="{{ path_to_root }}js/pagetoc.js"></script>
    <script src="{{ path_to_root }}js/custom.js"></script>
</body>
</html>
