# DISABLED — 2026-10-02. This file is inert: GitHub reads `.github/dependabot.yml`
# or `.github/dependabot.yaml` and nothing else, so the `.disabled` suffix
# stops all version-update PRs without deleting the reasoning below.
#
# WHY
#
# Dependabot's cargo bumps do not fail here, they fail AFTER the merge is
# already a green CI run. PR #2 (cargo-deps-3f020ecc6e, 23 updates) merged
# green and had to be reverted: the bumps cross trait generations that
# `trussed` 0.2 / `trussed-core` 0.2 have not moved to, so they cannot be
# adopted in fapico2 alone. The `ignore` block below was written to encode that
# — eight pinned entries, each naming the exact jump that breaks — and it did
# not hold. A bump that RECOMPILES is, for this dependency set, evidence of
# nothing: the breakage is in trait identity, which surfaces as a compile error
# in a *consumer* crate rather than in the bumped crate.
#
# So the version-update half is off. Dependency VULNERABILITY updates are a
# different mechanism and stay ON (see "what is still on" below) — a CVE in a
# transitive crate is worth knowing about even when the fix cannot be adopted
# in isolation.
#
# WHAT IS STILL ON
#
# `dependabot_security_updates` remains enabled on the repository
# (`security_and_analysis`). It opens a PR only for a known vulnerability, not
# for routine version drift, and it is the part with actual security value
# here. Verify with:
#
#   gh api repos/eddieoz/fapico2 --jq '.security_and_analysis'
#
# WHAT THIS DOES NOT DO
#
# Nothing below now watches upstream for new versions. Staying current on
# `trussed`, the RustCrypto crates, and the pinned `actions/*` SHAs is now a
# manual chore. The actions are pinned to commit SHAs (v7.0.1 checkout,
# v7.0.0 setup-python, v4.4.3 upload-artifact) rather than tags — that is the
# supply-chain control that matters for a repo whose release workflow signs
# artefacts, so an action bump is a path to a signing key and should stay
# deliberate rather than automated.
#
# To re-enable: rename this file back to `dependabot.yml`.
#
# ---------------------------------------------------------------------------
version: 2
updates:
  # The workspace itself: crates.io dependencies for the firmware, platform,
  # apps and the fuzz targets.
  - package-ecosystem: cargo
    directory: "/"
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    # PR #2 (cargo-deps-3f020ecc6e) was reverted: these bumps cross trait
    # generations that `trussed` 0.2 / `trussed-core` 0.2 have not moved to,
    # so they cannot be adopted in fapico2 alone. Each entry is pinned to the
    # exact jump that breaks, not the crate — patch and minor bumps on the
    # current line still land normally.
    #
    # `rand_core` 0.6 -> 0.7+: `trussed` 0.2.0's own manifest pins
    # `rand_core = "0.6"`, so `Rp2350Rng` (platform/src/trusted_backend/
    # device.rs) can no longer implement `trussed::service::RngCore` — a
    # foreign trait, not a source fix. `rand` is listed with it because
    # rand 0.9+ depends on the same moved `rand_core`, and the openpgp
    # host fixtures pass their `RngCore` values straight to the device
    # twin's trait methods.
    #
    # The RustCrypto entries: the 0.11/0.13/0.9/0.2 generation moved to
    # `digest` 0.11, while every crate here (platform, fido, oath, piv,
    # openpgp) plus trussed is on the `digest` 0.10 line. `Digest` and
    # `KeyInit` are distinct traits across those lines, so a hasher or
    # MAC built on one no longer satisfies a bound written against the
    # other. Unblock all of these together, when trussed does.
    ignore:
      - dependency-name: "rand_core"
        versions: [">=0.7.0"]
      - dependency-name: "rand"
        versions: [">=0.9.0"]
      - dependency-name: "sha2"
        versions: [">=0.11.0"]
      - dependency-name: "hmac"
        versions: [">=0.13.0"]
      - dependency-name: "hkdf"
        versions: [">=0.13.0"]
      - dependency-name: "aes"
        versions: [">=0.9.0"]
      - dependency-name: "cbc"
        versions: [">=0.2.0"]
    groups:
      # A firmware image is a single flash budget; unrelated dependency bumps
      # each cost a slot against the 3.5 MiB ceiling, so land them together.
      cargo-deps:
        applies-to: version-updates
        patterns: ["*"]

  # GitHub Actions. The release workflow signs and attests, so an unpinned
  # action is a supply-chain path to a signing key.
  - package-ecosystem: github-actions
    directory: "/"
    schedule:
      interval: weekly
    groups:
      github-actions:
        patterns: ["*"]
